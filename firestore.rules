rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidComment(data) {
      return data.keys().hasAll(['articleId', 'author', 'content', 'likes', 'createdAt'])
        && data.keys().hasOnly(['articleId', 'author', 'petName', 'content', 'likes', 'createdAt'])
        && data.articleId is string && data.articleId.size() > 0 && data.articleId.size() <= 100
        && data.author is string && data.author.size() > 0 && data.author.size() <= 100
        && (!('petName' in data) || (data.petName is string && data.petName.size() <= 100))
        && data.content is string && data.content.size() > 0 && data.content.size() <= 2000
        && data.likes is number && data.likes >= 0
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 50;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isValidComment(request.resource.data) && request.resource.data.likes == 0;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
                    && request.resource.data.likes == resource.data.likes + 1;
      allow delete: if false;
    }

    match /article_reactions/{articleId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['articleId', 'likes', 'pawReactions', 'usefulReactions'])
                   && request.resource.data.articleId == articleId
                   && request.resource.data.likes is number
                   && request.resource.data.pawReactions is number
                   && request.resource.data.usefulReactions is number;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
